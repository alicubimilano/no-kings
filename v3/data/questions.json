      "category": "Potere",
      "categoryKey": "potere",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 69,
      "id": "70",
      "displayId": "070",
      "text": "Come posso dire una cosa difficile senza ferire?",
      "type": "Esperienza",
      "category": "Parola che apre/chiude",
      "categoryKey": "parola-apre-chiude",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 70,
      "id": "71",
      "displayId": "071",
      "text": "Che potere ha il silenzio?",
      "type": "Esperienza",
      "category": "Voce e ascolto",
      "categoryKey": "voce-ascolto",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 71,
      "id": "72",
      "displayId": "072",
      "text": "Durante un gioco tutti parlano insieme e nessuno ti lascia finire una frase. Che cosa fai?",
      "type": "Situazione",
      "category": "Fatica",
      "categoryKey": "fatica",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 72,
      "id": "73",
      "displayId": "073",
      "text": "Un amico racconta un tuo segreto senza chiederti il permesso. Che cosa fai?",
      "type": "Situazione",
      "category": "Fatica",
      "categoryKey": "fatica",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 73,
      "id": "74",
      "displayId": "074",
      "text": "Un amico insiste perché tu faccia una cosa che non ti convince. Che cosa dici?",
      "type": "Situazione",
      "category": "Fatica",
      "categoryKey": "fatica",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 74,
      "id": "75",
      "displayId": "075",
      "text": "Durante un lavoro di gruppo una tua idea viene ignorata. Che cosa fai?",
      "type": "Situazione",
      "category": "Fatica",
      "categoryKey": "fatica",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 75,
      "id": "76",
      "displayId": "076",
      "text": "Hai cambiato idea su una cosa importante, ma temi il giudizio degli altri. Che cosa fai?",
      "type": "Situazione",
      "category": "Fatica",
      "categoryKey": "fatica",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 76,
      "id": "77",
      "displayId": "077",
      "text": "Devi scusarti, ma non sai come. Che cosa fai?",
      "type": "Situazione",
      "category": "Fatica",
      "categoryKey": "fatica",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 77,
      "id": "78",
      "displayId": "078",
      "text": "Come immagini un mondo in cui tutti possono prendere parola?",
      "type": "Esperienza",
      "category": "Desiderio / Comunità",
      "categoryKey": "desiderio-comunita",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 78,
      "id": "79",
      "displayId": "079",
      "text": "Ti piacerebbe che nel mondo ci fossero sempre rispetto e gentilezza?",
      "type": "Esperienza",
      "category": "Desiderio / Comunità",
      "categoryKey": "desiderio-comunita",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 79,
      "id": "80",
      "displayId": "080",
      "text": "Cambiare idea è una debolezza?",
      "type": "Esperienza",
      "category": "Fatica",
      "categoryKey": "fatica",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 80,
      "id": "81",
      "displayId": "081",
      "text": "Quali comportamenti renderebbero più facile vivere insieme nonostante le differenze?",
      "type": "Esperienza",
      "category": "Desiderio / Comunità",
      "categoryKey": "desiderio-comunita",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 81,
      "id": "82",
      "displayId": "082",
      "text": "Che cosa serve per costruire un gruppo in cui tutti possano sentirsi accolti?",
      "type": "Esperienza",
      "category": "Desiderio / Comunità",
      "categoryKey": "desiderio-comunita",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 82,
      "id": "84",
      "displayId": "084",
      "text": "Affrontare insieme le sfide può migliorare una comunità?",
      "type": "Esperienza",
      "category": "Desiderio / Comunità",
      "categoryKey": "desiderio-comunita",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 83,
      "id": "85",
      "displayId": "085",
      "text": "Come si può dire la verità in un modo che apra il dialogo invece di chiuderlo?",
      "type": "Esperienza",
      "category": "Parola che apre/chiude",
      "categoryKey": "parola-apre-chiude",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 84,
      "id": "86",
      "displayId": "086",
      "text": "Perché a volte è difficile chiedere scusa anche alle persone a cui teniamo?",
      "type": "Esperienza",
      "category": "Fatica",
      "categoryKey": "fatica",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 85,
      "id": "87",
      "displayId": "087",
      "text": "Che cosa aiuta una persona ad avere il coraggio di essere se stessa?",
      "type": "Esperienza",
      "category": "Strategia",
      "categoryKey": "strategia",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 86,
      "id": "88",
      "displayId": "088",
      "text": "Dove trovi il tuo equilibrio quando temi di essere giudicato?",
      "type": "Esperienza",
      "category": "Strategia",
      "categoryKey": "strategia",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 87,
      "id": "101",
      "displayId": "101",
      "text": "Come capisci quando quello che stai dicendo rischia di fare male a qualcuno?",
      "type": "Esperienza",
      "category": "Parola che apre/chiude",
      "categoryKey": "parola-apre-chiude",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 88,
      "id": "93",
      "displayId": "093",
      "text": "Che cosa potresti fare quando incontri una persona in difficoltà che chiede aiuto?",
      "type": "Situazione",
      "category": "Desiderio / Comunità",
      "categoryKey": "desiderio-comunita",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 89,
      "id": "94",
      "displayId": "094",
      "text": "Come reagisci quando una persona usa la propria influenza per creare paura o divisioni?",
      "type": "Situazione",
      "category": "Potere",
      "categoryKey": "potere",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 90,
      "id": "97",
      "displayId": "097",
      "text": "Quando la sincerità rafforza un’amicizia e quando rischia di metterla in difficoltà?",
      "type": "Esperienza",
      "category": "Parola che apre/chiude",
      "categoryKey": "parola-apre-chiude",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 91,
      "id": "98",
      "displayId": "098",
      "text": "Che cosa fanno le persone che ti fanno sentire libero di essere te stesso?",
      "type": "Esperienza",
      "category": "Desiderio / Comunità",
      "categoryKey": "desiderio-comunita",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 92,
      "id": "99",
      "displayId": "099",
      "text": "Fai fatica a cambiare idea?",
      "type": "Esperienza",
      "category": "Fatica",
      "categoryKey": "fatica",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 93,
      "id": "100",
      "displayId": "100",
      "text": "Quali paure o pensieri possono impedirti di cambiare opinione?",
      "type": "Esperienza",
      "category": "Fatica",
      "categoryKey": "fatica",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 94,
      "id": "102",
      "displayId": "102",
      "text": "Perché a volte la diversità degli altri ci mette in difficoltà?",
      "type": "Esperienza",
      "category": "Fatica",
      "categoryKey": "fatica",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 95,
      "id": "103",
      "displayId": "103",
      "text": "Come sarebbe una classe in cui non si avvertono preferenze?",
      "type": "Esperienza",
      "category": "Desiderio / Comunità",
      "categoryKey": "desiderio-comunita",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 96,
      "id": "104",
      "displayId": "104",
      "text": "Quanto è importante accettare la propria diversità?",
      "type": "Esperienza",
      "category": "Desiderio / Comunità",
      "categoryKey": "desiderio-comunita",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 97,
      "id": "105",
      "displayId": "105",
      "text": "Come reagisci di fronte a un insulto su una tua caratteristica?",
      "type": "Esperienza",
      "category": "Parola che apre/chiude",
      "categoryKey": "parola-apre-chiude",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 98,
      "id": "106",
      "displayId": "106",
      "text": "Come sarebbe un mondo in cui le persone riescono a trasformare le proprie debolezze in punti di forza?",
      "type": "Esperienza",
      "category": "Desiderio / Comunità",
      "categoryKey": "desiderio-comunita",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 99,
      "id": "107",
      "displayId": "107",
      "text": "Quando pensi che sia giusto rinunciare a qualcosa di tuo per il bene di qualcun altro?",
      "type": "Esperienza",
      "category": "Desiderio / Comunità",
      "categoryKey": "desiderio-comunita",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 100,
      "id": "108",
      "displayId": "108",
      "text": "Quale contributo daresti per il bene della comunità?",
      "type": "Esperienza",
      "category": "Desiderio / Comunità",
      "categoryKey": "desiderio-comunita",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 101,
      "id": "109",
      "displayId": "109",
      "text": "Cosa ne pensi del rispetto delle regole?",
      "type": "Esperienza",
      "category": "Potere",
      "categoryKey": "potere",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 102,
      "id": "110",
      "displayId": "110",
      "text": "Come ti comporti davanti a una sconfitta?",
      "type": "Esperienza",
      "category": "Strategia",
      "categoryKey": "strategia",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 103,
      "id": "111",
      "displayId": "111",
      "text": "Non sei d'accordo con il comportamento del resto del gruppo, cosa fai?",
      "type": "Situazione",
      "category": "Voce e ascolto",
      "categoryKey": "voce-ascolto",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 104,
      "id": "112",
      "displayId": "112",
      "text": "Come puoi dire a un amico che sta sbagliando?",
      "type": "Esperienza",
      "category": "Voce e ascolto",
      "categoryKey": "voce-ascolto",
      "editorialStatus": "APPROVATA — VERSIONE 2"
    },
    {
      "masterOrder": 105,
      "id": "113",
      "displayId": "113",
      "text": "Il bullo ha paura?",
      "type": "Esperienza",
      "category": "Potere",
      "categoryKey": "potere",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 106,
      "id": "114",
      "displayId": "114",
      "text": "Perché una persona si comporta da bullo?",
      "type": "Esperienza",
      "category": "Potere",
      "categoryKey": "potere",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 107,
      "id": "115",
      "displayId": "115",
      "text": "Perché un bullo può sembrare il leader di un gruppo?",
      "type": "Esperienza",
      "category": "Potere",
      "categoryKey": "potere",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 108,
      "id": "116",
      "displayId": "116",
      "text": "Quale messaggio vorresti dare a una persona che si comporta da bullo?",
      "type": "Esperienza",
      "category": "Parola che apre/chiude",
      "categoryKey": "parola-apre-chiude",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 109,
      "id": "117",
      "displayId": "117",
      "text": "Che cosa ti aiuta a fare conoscenza con un nuovo gruppo?",
      "type": "Esperienza",
      "category": "Strategia",
      "categoryKey": "strategia",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 110,
      "id": "118",
      "displayId": "118",
      "text": "Che cosa ti aiuta ad ascoltare una critica senza chiuderti?",
      "type": "Esperienza",
      "category": "Voce e ascolto",
      "categoryKey": "voce-ascolto",
      "editorialStatus": "APPROVATA — VERSIONE 2"
    },
    {
      "masterOrder": 111,
      "id": "119",
      "displayId": "119",
      "text": "Hai chiesto scusa, ma l’altra persona non le accetta: che cosa puoi dire?",
      "type": "Situazione",
      "category": "Parola che apre/chiude",
      "categoryKey": "parola-apre-chiude",
      "editorialStatus": "APPROVATA — VERSIONE 2"
    },
    {
      "masterOrder": 112,
      "id": "120",
      "displayId": "120",
      "text": "Un compagno chiede scusa ma non cambia atteggiamento. Cosa fai?",
      "type": "Situazione",
      "category": "Parola che apre/chiude",
      "categoryKey": "parola-apre-chiude",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 113,
      "id": "121",
      "displayId": "121",
      "text": "Che cosa può fare il gruppo quando chi lo guida si comporta in modo negativo?",
      "type": "Situazione",
      "category": "Potere",
      "categoryKey": "potere",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 114,
      "id": "122",
      "displayId": "122",
      "text": "Che cosa fai quando un amico si comporta male, anche se per te è una persona importante?",
      "type": "Situazione",
      "category": "Strategia",
      "categoryKey": "strategia",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 115,
      "id": "123",
      "displayId": "123",
      "text": "Cosa significa per te ascoltare?",
      "type": "Esperienza",
      "category": "Voce e ascolto",
      "categoryKey": "voce-ascolto",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 116,
      "id": "124",
      "displayId": "124",
      "text": "Quando sei in difficoltà, chiedi aiuto?",
      "type": "Esperienza",
      "category": "Strategia",
      "categoryKey": "strategia",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 117,
      "id": "125",
      "displayId": "125",
      "text": "Credi sia importante dire ciò che pensi?",
      "type": "Esperienza",
      "category": "Voce e ascolto",
      "categoryKey": "voce-ascolto",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 118,
      "id": "126",
      "displayId": "126",
      "text": "Un amico la pensa diversamente da te. Continui ad ascoltarlo?",
      "type": "Situazione",
      "category": "Voce e ascolto",
      "categoryKey": "voce-ascolto",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 119,
      "id": "127",
      "displayId": "127",
      "text": "Che cosa può spingere un gruppo a escludere una persona?",
      "type": "Esperienza",
      "category": "Desiderio / Comunità",
      "categoryKey": "desiderio-comunita",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 120,
      "id": "128",
      "displayId": "128",
      "text": "Che cosa ti aiuta ad ascoltare davvero una persona?",
      "type": "Esperienza",
      "category": "Voce e ascolto",
      "categoryKey": "voce-ascolto",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 121,
      "id": "129",
      "displayId": "129",
      "text": "Cosa permette a una persona di essere ascoltata?",
      "type": "Esperienza",
      "category": "Voce e ascolto",
      "categoryKey": "voce-ascolto",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 122,
      "id": "130",
      "displayId": "130",
      "text": "Quale tono di voce ti aiuta ad essere ascoltato?",
      "type": "Esperienza",
      "category": "Voce e ascolto",
      "categoryKey": "voce-ascolto",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 123,
      "id": "131",
      "displayId": "131",
      "text": "Quale tono di voce usi quando vuoi dire una cosa importante?",
      "type": "Esperienza",
      "category": "Voce e ascolto",
      "categoryKey": "voce-ascolto",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 124,
      "id": "132",
      "displayId": "132",
      "text": "La fatica è sempre una cosa negativa?",
      "type": "Esperienza",
      "category": "Fatica",
      "categoryKey": "fatica",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 125,
      "id": "133",
      "displayId": "133",
      "text": "Hai offeso un amico e ora non ti parla più: come puoi riaprire il dialogo?",
      "type": "Situazione",
      "category": "Voce e ascolto",
      "categoryKey": "voce-ascolto",
      "editorialStatus": "APPROVATA — VERSIONE 2"
    },
    {
      "masterOrder": 126,
      "id": "134",
      "displayId": "134",
      "text": "Quali emozioni possono nascondersi dietro il comportamento di un bullo?",
      "type": "Esperienza",
      "category": "Potere",
      "categoryKey": "potere",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 127,
      "id": "135",
      "displayId": "135",
      "text": "Che cosa rende difficile parlare con una persona che si comporta da bullo?",
      "type": "Esperienza",
      "category": "Fatica",
      "categoryKey": "fatica",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 128,
      "id": "136",
      "displayId": "136",
      "text": "Secondo te gli adulti condannano sempre ciò che è sbagliato?",
      "type": "Esperienza",
      "category": "Potere",
      "categoryKey": "potere",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 129,
      "id": "137",
      "displayId": "137",
      "text": "Secondo te quando gli adulti non danno un buon esempio?",
      "type": "Esperienza",
      "category": "Potere",
      "categoryKey": "potere",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 130,
      "id": "138",
      "displayId": "138",
      "text": "Come potrebbe sentirsi un bullo dopo aver fatto del male a qualcuno?",
      "type": "Situazione",
      "category": "Potere",
      "categoryKey": "potere",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 131,
      "id": "139",
      "displayId": "139",
      "text": "Gli adulti litigano con i bambini? O viceversa?",
      "type": "Esperienza",
      "category": "Potere",
      "categoryKey": "potere",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 132,
      "id": "140",
      "displayId": "140",
      "text": "Che cosa succede dentro di te quando qualcuno mette in discussione una tua idea?",
      "type": "Esperienza",
      "category": "Fatica",
      "categoryKey": "fatica",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    },
    {
      "masterOrder": 133,
      "id": "141",
      "displayId": "141",
      "text": "La fatica è sempre necessaria?",
      "type": "Esperienza",
      "category": "Fatica",
      "categoryKey": "fatica",
      "editorialStatus": "APPROVATA — VERSIONE 1"
    }
  ]
